# ---------------------------------------------------------------------------
# TVB Lead Agent - environment configuration
# Copy to `.env` and fill in what you have. Everything is optional: the agent
# degrades to keyless fallbacks rather than failing. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Web search (at least one strongly recommended) ------------------------
# Serper: https://serper.dev            2,500 free credits, no card
SERPER_API_KEY=
# Tavily: https://tavily.com            1,000 free searches/month
TAVILY_API_KEY=
# Brave:  https://brave.com/search/api  2,000 free queries/month
BRAVE_API_KEY=
# Google Programmable Search (100/day free)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Keyless last resort. Fragile and easily blocked; fine for local trials.
ALLOW_DDG_FALLBACK=true

# --- Extraction model (optional; rule-based fallback used when absent) ------
# Gemini: https://aistudio.google.com/apikey   generous free tier, no card
GEMINI_API_KEY=
# Model names are retired periodically. If this one 404s the agent falls
# back through newer names automatically; set it only to pin a specific model.
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free LLM tiers limit requests per minute. Lower these if you see rate limits.
LLM_MAX_RPM=12
LLM_CONCURRENCY=2
ANTHROPIC_API_KEY=

# --- Email deliverability (optional; MX + source attribution used when absent)
# ZeroBounce: https://zerobounce.net    100 free credits
ZEROBOUNCE_API_KEY=
# Hunter:     https://hunter.io          50 free verifications/month
HUNTER_API_KEY=
# Abstract:   https://abstractapi.com    100 free requests
ABSTRACT_EMAIL_API_KEY=

# --- Contact enrichment (optional) ------------------------------------------
# Apollo: https://apollo.io  ->  Settings > Integrations > API
# Asked only about a founder the agent has already identified from its own
# evidence, and only an Apollo status of "verified" is accepted; the provenance
# is recorded on the lead so a database-sourced address is never mistaken for
# one published on a page. Without this the agent finds only addresses it can
# read on a page, which is a much smaller set.
APOLLO_API_KEY=

# --- Qualification thresholds ----------------------------------------------
MIN_AMOUNT_USD=1000000
MAX_AMOUNT_USD=5000000
BOUNDARY_TOLERANCE=0.10
MAX_WEAK_US_SIGNALS=1

# --- Run budget -------------------------------------------------------------
TARGET_QUALIFIED=15
MAX_SEARCHES=250
MAX_COMPANIES=120
MAX_PAGES=600
MAX_LLM_CALLS=250
MAX_EMAIL_VERIFICATIONS=80
MAX_RUNTIME_SECONDS=1500
CONCURRENCY=8

# --- Crawler behaviour ------------------------------------------------------
DB_PATH=data/tvb_agent.sqlite3
RESPECT_ROBOTS=true
PER_HOST_DELAY=1.0
HTTP_TIMEOUT=20
CACHE_TTL_SECONDS=86400
USER_AGENT=TVB-Lead-Agent/1.0 (research crawler; contact via repository issues)
