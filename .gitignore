# Secrets - never commit
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.key
*.pem

# Data produced by runs
data/*.sqlite3
data/*.sqlite3-*
data/*.db
*.csv
*.json
!package.json
!tests/**/*.json
# The verified leads that ship with the repo, so the hosted app opens with
# real output instead of an empty page. Contains no keys and no private data.
!data/shipped_leads.json

