# Streamlit Community Cloud: paste this into
#   Manage app -> Settings -> Secrets
# (Never commit the real secrets.toml - it is git-ignored.)

SERPER_API_KEY = "your-serper-key"
GEMINI_API_KEY = "your-gemini-key"
ZEROBOUNCE_API_KEY = "your-zerobounce-key"
HUNTER_API_KEY = "your-hunter-key"      # finds founder addresses AND verifies them
APOLLO_API_KEY = "your-apollo-key"      # optional; free tier does not release emails

TARGET_QUALIFIED = "15"
MAX_RUNTIME_SECONDS = "900"
DB_PATH = "data/tvb_agent.sqlite3"
